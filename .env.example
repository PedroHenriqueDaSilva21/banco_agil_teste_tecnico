# ─── AWS Credentials ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Amazon Bedrock — Modelo de LLM ──────────────────────────────────────────
# Modelo utilizado pelos agentes de IA para raciocínio e geração de respostas.
# Este projeto não utiliza embeddings ou banco vetorial — todas as operações
# de dados são determinísticas (busca em CSV, cálculos de score, chamadas de API).
#
# Exemplos de modelos disponíveis:
#   amazon.nova-micro-v1:0     (rápido e leve, recomendado)
#   amazon.nova-lite-v1:0      (balanceado)
#   amazon.nova-pro-v1:0       (mais capaz, maior custo)
#   anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_LLM_MODEL=amazon.nova-micro-v1:0